const year = new Date().getFullYear();
const services = [
  ['Websites premium', 'O teu site é a primeira impressão que não dá para repetir. Criamos páginas rápidas, com design que transmite autoridade e estrutura pensada para transformar visitas em contactos reais.', '01'],
  ['Automação com IA', 'Elimina tarefas manuais que consomem tempo sem gerar resultado. Implementamos agentes de IA que respondem, qualificam, agendam e acompanham clientes enquanto a tua equipa foca no que importa.', '02'],
