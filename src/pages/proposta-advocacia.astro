  { dor: "Clientes sumindo antes de fechar o contrato", solucao: "Fluxo automático de nutrição e follow-up (24h, 48h, 7 dias após consulta)" },
  { dor: "Consultas iniciais agendadas por telefone ou DM sem controle", solucao: "Agendamento online integrado ao WhatsApp com confirmação automática" },
  { dor: "Documentação pendente travando o processo — cliente não entrega", solucao: "Régua automática de cobrança de documentos via WhatsApp com lembretes periódicos" },
  { dor: "Sem atualização proativa sobre andamento do processo", solucao: "Fluxo automático de status: cliente recebe update sem precisar ligar para o escritório" },
