{
  "name": "app-extrator",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:local": "astro dev --host 127.0.0.1 --port 3000",
    "tunnel": "cloudflared tunnel --config cloudflared/config.yml run app-extrator",
    "dev:tunnel": "sh -c 'npm run dev:local & DEV_PID=$!; trap \"kill $DEV_PID\" EXIT INT TERM; cloudflared tunnel --config cloudflared/config.yml run app-extrator'",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^10.1.1",
    "astro": "^6.3.8"
  },
  "devDependencies": {
    "puppeteer": "^25.1.0"
  }
}
